# Server configuration
PORT=3000
NODE_ENV=development

# SmartAPI credentials
API_KEY=
CLIENT_CODE=
CLIENT_PIN=
CLIENT_TOTP_PIN=
# Your TOTP secret key provided by Angel Broking (e.g., 16 or 26 characters)

# Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
USE_TELEGRAM=true

# Slack notifications
SLACK_WEBHOOK_URL=
SLACK_SIGNING_SECRET=
USE_SLACK=false

# Option chain data lake path (data/chains dir from the nifty-optionchain-data repo)
OPTIONCHAIN_DATA_DIR=

# Strategy entry and exit times (HH:mm format)
ENTRY_TIME=09:15
EXIT_TIME=15:17
NO_ENTRY_AFTER=15:10